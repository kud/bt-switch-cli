{
  "name": "@kud/bt-switch-cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Bluetooth device handoff CLI — switch Magic peripherals between Macs by name",
  "keywords": [
    "bluetooth",
    "blueutil",
    "cli",
    "macos",
    "magic-trackpad",
    "magic-keyboard",
    "handoff"
  ],
  "homepage": "https://kud.io/projects/bt-switch-cli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kud/bt-switch-cli.git"
  },
  "license": "MIT",
  "author": "Erwann Mest <m@kud.io>",
  "bin": {
    "bt-switch": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsup src/index.tsx --format esm --dts",
    "build:watch": "tsup src/index.tsx --format esm --dts --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "chalk": "5.6.2",
    "citty": "0.2.2",
    "execa": "9.6.1",
    "ink": "7.1.0",
    "ink-spinner": "5.0.0",
    "react": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "eslint": "10.6.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.4",
    "tsup": "8.5.1",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
